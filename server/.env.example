# 대담 서버 환경변수
#
# 이 파일을 `.env`로 복사해서 값을 채웁니다. `.env`는 gitignore 대상입니다.
#   cp .env.example .env
#
# `adk web`은 실행 디렉터리(= server/)의 .env를 읽습니다.

# ── Gemini ───────────────────────────────────────────────────────────────
# 실시간 음성 면접(Live)과 회사 리서치(Deep Research)에 쓴다.

# FALSE = Google AI Studio (API 키 방식) / TRUE = Vertex AI (프로젝트·리전 방식).
# 레거시 별칭 GOOGLE_GENAI_USE_VERTEXAI도 인식하지만 둘 다 있으면 이쪽이 이긴다.
GOOGLE_GENAI_USE_ENTERPRISE=FALSE

# https://aistudio.google.com/apikey 에서 발급.
GOOGLE_API_KEY=

# ── xAI (Grok) ───────────────────────────────────────────────────────────
# 뼈대질문 풀 생성과 답변 내용 평가에 쓴다. 오프라인 배치 전용이라
# 면접 세션 중에는 호출하지 않는다.
XAI_API_KEY=

# ── 로그인 ───────────────────────────────────────────────────────────────
# 비워 두면 로그인 없이 돈다 — 모든 데이터가 기본 사용자 한 명의 것이다.
# 하나라도 채우면 로그인을 요구한다.
#
# **콘솔 설정 절차는 docs/oauth-setup.md에 단계별로 적어 두었다.**
# 카카오는 [OpenID Connect] 활성화를 빠뜨리기 쉽다 — 그러면 로그인이 됐다가
# 마지막에 502로 떨어진다.
#
# 콜백(Redirect URI)은 서버 주소 + /api/auth/{제공자}/callback 이다.
#   로컬:  http://localhost:8000/api/auth/kakao/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 요구할 동의항목. 카카오는 표준 OIDC 이름(profile·email)이 아니라 자기
# 동의항목 id를 쓴다. **콘솔에서 켠 것만 적어야 한다** — 안 켠 항목을
# 요구하면 로그인이 통째로 거절된다. 이메일을 못 켰으면 이렇게 낮춘다:
#   KAKAO_SCOPE=openid profile_nickname profile_image
KAKAO_SCOPE=
GOOGLE_SCOPE=

# 세션 쿠키 서명 키. 비우면 기동할 때마다 새로 만들어 모두 로그아웃된다 —
# 배포에서는 반드시 고정한다.  python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# HTTPS로 서비스하면 1. 쿠키에 Secure 플래그가 붙는다.
COOKIE_SECURE=0

# 이 서버의 공개 주소. 제공자 콘솔에 등록한 콜백이 여기에
# /api/auth/{제공자}/callback을 붙인 값이어야 한다. 비우면 요청 헤더에서
# 유도하는데, 그러면 localhost로 들어왔는지 127.0.0.1로 들어왔는지에 따라
# 값이 갈리고 카카오는 KOE006으로 거절한다. 리버스 프록시 뒤에서도 못 박을 것.
SERVER_BASE_URL=http://localhost:8000

# 로그인 뒤 돌아갈 곳. 배포에서는 프론트와 서버가 같은 오리진이라 비워 둔다.
# 개발에서는 vite가 따로 떠 있으므로 그쪽을 적는다:
#   APP_BASE_URL=http://localhost:5173
APP_BASE_URL=

# ── 크레딧 ───────────────────────────────────────────────────────────────
# 단위는 면접 한 판이다 — 1 크레딧 = 면접 1회. 등록(Deep Research)은 더 무거워
# 그 몇 배로 매긴다. 실제 결제 연동은 아직 없다(사업자등록이 선행되어야 한다).
# 1크레딧 990원 기준으로 등록 5,940원 · 면접 3,960원(마진 53%).
# 근거는 docs/specs/2026-08-23-credit-pricing.md.
CREDITS_SIGNUP_GRANT=4
CREDITS_PER_RESEARCH=6
CREDITS_PER_INTERVIEW=4

# ── 면접 설정 ────────────────────────────────────────────────────────────
# demo = 5~6분(단계 60/180/0/60초) — 시연용. 인성 단계를 건너뛴다.
# dev  = 8분 — 개발용. 네 단계를 다 돈다.
# full = 17분 목표 / 하드캡 20분 — 제품 정의.
INTERVIEW_PROFILE=demo

# ── 리서치 모드 ──────────────────────────────────────────────────────────
# fixture = 저장된 리포트를 그대로 쓴다. 기본값.
# live    = Gemini Deep Research를 실제로 호출한다.
#           작업당 10~15분, $1~3이 든다. 반복 실행에 주의.
RESEARCH_MODE=fixture

# ── 지식 검색 임베딩 ─────────────────────────────────────────────────────
# gemini = Gemini 임베딩 API. **기본값.** 메모리·CPU를 안 쓰고 GOOGLE_API_KEY를
#          그대로 쓴다. 실측: 청크 100개 인덱스 2.2초, 질의 0.47초.
# local  = 로컬 모델(KURE-v1). 외부 호출을 피해야 하거나 오프라인일 때.
#          `uv sync --extra local-embedding`이 먼저 필요하고, GPU가 없으면
#          느리다 — 2 vCPU 실측으로 인덱스 50초, 질의 0.82초, 메모리 +1.15GB.
# off    = BM25 단독. 키가 없는 환경과 테스트.
SEARCH_EMBEDDINGS=gemini

# ── 데이터베이스 ─────────────────────────────────────────────────────────
# 비우면 데이터 디렉터리의 SQLite 파일(data/daedam.db)을 쓴다. 단일 인스턴스
# 배포에는 그것으로 충분하다. 인스턴스를 늘리면 PostgreSQL로 옮긴다:
#   DATABASE_URL=postgresql://user:password@host:5432/daedam
DATABASE_URL=
