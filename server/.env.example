# 대담 서버 환경변수
#
# 이 파일을 `.env`로 복사해서 값을 채웁니다. `.env`는 gitignore 대상입니다.
#   cp .env.example .env
#
# `adk web`은 실행 디렉터리(= server/)의 .env를 읽습니다.

# ── Gemini ───────────────────────────────────────────────────────────────
# 실시간 음성 면접(Live)과 회사 리서치(Deep Research)에 쓴다.

# FALSE = Google AI Studio (API 키 방식) / TRUE = Vertex AI (프로젝트·리전 방식).
# 레거시 별칭 GOOGLE_GENAI_USE_VERTEXAI도 인식하지만 둘 다 있으면 이쪽이 이긴다.
GOOGLE_GENAI_USE_ENTERPRISE=FALSE

# https://aistudio.google.com/apikey 에서 발급.
GOOGLE_API_KEY=

# ── xAI (Grok) ───────────────────────────────────────────────────────────
# 뼈대질문 풀 생성과 답변 내용 평가에 쓴다. 오프라인 배치 전용이라
# 면접 세션 중에는 호출하지 않는다.
XAI_API_KEY=

# ── 면접 설정 ────────────────────────────────────────────────────────────
# demo = 8분(단계 90/180/150/60초, 하드캡 9분) — 개발·시연용.
#        Live API 커넥션 수명(~10분) 안쪽이라 시연 중 재연결 경로를 타지 않는다.
# full = 17분 목표 / 하드캡 20분 — 제품 정의.
INTERVIEW_PROFILE=demo

# ── 리서치 모드 ──────────────────────────────────────────────────────────
# fixture = 저장된 리포트를 그대로 쓴다. 기본값.
# live    = Gemini Deep Research를 실제로 호출한다.
#           작업당 20~60분, $1~7이 든다. 반복 실행에 주의.
RESEARCH_MODE=fixture
