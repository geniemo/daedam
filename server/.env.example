# 대담 서버 환경변수
#
# 이 파일을 `.env`로 복사해서 값을 채웁니다. `.env`는 gitignore 대상입니다.
#   cp .env.example .env
#
# `adk web`은 실행 디렉터리(= server/)의 .env를 읽습니다.

# ── Gemini ───────────────────────────────────────────────────────────────
# 실시간 음성 면접(Live)과 회사 리서치(Deep Research)에 쓴다.

# FALSE = Google AI Studio (API 키 방식) / TRUE = Vertex AI (프로젝트·리전 방식).
# 레거시 별칭 GOOGLE_GENAI_USE_VERTEXAI도 인식하지만 둘 다 있으면 이쪽이 이긴다.
GOOGLE_GENAI_USE_ENTERPRISE=FALSE

# https://aistudio.google.com/apikey 에서 발급.
GOOGLE_API_KEY=

# ── xAI (Grok) ───────────────────────────────────────────────────────────
# 뼈대질문 풀 생성과 답변 내용 평가에 쓴다. 오프라인 배치 전용이라
# 면접 세션 중에는 호출하지 않는다.
XAI_API_KEY=

# ── 로그인 ───────────────────────────────────────────────────────────────
# 비워 두면 로그인 없이 돈다 — 모든 데이터가 기본 사용자 한 명의 것이다.
# 하나라도 채우면 로그인을 요구한다.
#
# 콜백(Redirect URI)은 서버 주소 + /api/auth/{제공자}/callback 이다.
#   로컬:  http://localhost:8000/api/auth/kakao/callback
#
# 카카오 https://developers.kakao.com — 내 애플리케이션 > 카카오 로그인
#        (보안 > Client Secret을 발급해야 한다)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 구글 https://console.cloud.google.com/apis/credentials — OAuth 2.0 클라이언트 ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 세션 쿠키 서명 키. 비우면 기동할 때마다 새로 만들어 모두 로그아웃된다 —
# 배포에서는 반드시 고정한다.  python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# HTTPS로 서비스하면 1. 쿠키에 Secure 플래그가 붙는다.
COOKIE_SECURE=0

# ── 크레딧 ───────────────────────────────────────────────────────────────
# 단위는 면접 한 판이다 — 1 크레딧 = 면접 1회. 등록(Deep Research)은 더 무거워
# 그 몇 배로 매긴다. 실제 결제 연동은 아직 없다(사업자등록이 선행되어야 한다).
CREDITS_SIGNUP_GRANT=5
CREDITS_PER_RESEARCH=3
CREDITS_PER_INTERVIEW=1

# ── 면접 설정 ────────────────────────────────────────────────────────────
# demo = 5~6분(단계 60/180/0/60초) — 시연용. 인성 단계를 건너뛴다.
# dev  = 8분 — 개발용. 네 단계를 다 돈다.
# full = 17분 목표 / 하드캡 20분 — 제품 정의.
INTERVIEW_PROFILE=demo

# ── 리서치 모드 ──────────────────────────────────────────────────────────
# fixture = 저장된 리포트를 그대로 쓴다. 기본값.
# live    = Gemini Deep Research를 실제로 호출한다.
#           작업당 10~15분, $1~3이 든다. 반복 실행에 주의.
RESEARCH_MODE=fixture

# ── 지식 검색 임베딩 ─────────────────────────────────────────────────────
# local = KURE-v1을 로컬(GPU 있으면 GPU)에서 돌려 BM25에 의미 검색을 얹는다.
#         기본값. 첫 실행 시 모델(~2GB)을 내려받는다.
# off   = BM25 단독. 모델을 받을 수 없거나 CPU 전용 배포일 때.
SEARCH_EMBEDDINGS=local

# ── 데이터베이스 ─────────────────────────────────────────────────────────
# 비우면 데이터 디렉터리의 SQLite 파일(data/daedam.db)을 쓴다. 단일 인스턴스
# 배포에는 그것으로 충분하다. 인스턴스를 늘리면 PostgreSQL로 옮긴다:
#   DATABASE_URL=postgresql://user:password@host:5432/daedam
DATABASE_URL=
