# Voice session transport.
#
# unset / 0 → 프로토타입 타이밍으로 동작합니다. 질문당 14초 사이클
#              (발화 5초 → 청취 9초), 8질문 후 분석 화면으로.
#              백엔드 없이 UI 전체를 돌려볼 수 있습니다.
#
# 1          → /ws/interview 로 실제 WebSocket을 열고 마이크를 캡처합니다.
#              ADK 서버가 떠 있어야 합니다 (vite.config.ts의 proxy 참고).
VITE_VOICE_BACKEND=0
